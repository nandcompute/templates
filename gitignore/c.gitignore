# =============================================================
# C project .gitignore
# Based on the github/gitignore C template, plus additions
# Nand Compute Templates — gitignore/c.gitignore
#
# Copy to the project root as .gitignore. Check a path with:
#   git check-ignore -v <path>
# =============================================================

# ---------- Object files ----------
*.o
*.ko
*.obj
*.elf

# ---------- Compiler intermediates ----------
# Dependency files from -MD / -MMD
*.d
# Preprocessed output (-E / -save-temps). Note: *.s is NOT ignored,
# since hand-written assembly is source.
*.i
*.ii
# Split DWARF
*.dwo

# ---------- Linker output ----------
*.ilk
*.map
*.exp

# ---------- Precompiled headers ----------
*.gch
*.pch

# ---------- Libraries ----------
*.lib
*.a
*.la
*.lo

# ---------- Shared objects (incl. Windows DLLs) ----------
*.dll
*.so
*.so.*
*.dylib

# ---------- Executables ----------
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# ---------- Debug files & crash dumps ----------
*.dSYM/
*.su
*.idb
*.pdb
core
core.[0-9]*
vgcore.*
*.stackdump

# ---------- Kernel module build artifacts ----------
# Narrower than the upstream "*.mod*" and "*.cmd", which also match
# unrelated files (e.g. Windows build.cmd scripts, *.modulemap).
*.mod
*.mod.c
*.mod.o
.*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# ---------- Build directories ----------
# Anchored to the repo root so source dirs like src/debug/ or
# tools/bin/ aren't swallowed. Drop the leading "/" if a project
# builds in nested directories.
/build/
/build-*/
/Build/
/Build-*/
/debug/
/debug-*/
/Debug/
/Debug-*/
/release/
/release-*/
/Release/
/Release-*/
/out/
/bin/
/obj/

# ---------- CMake ----------
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/

# ---------- Autotools ----------
autom4te.cache/
config.log
config.status
stamp-h1
.deps/
.libs/
# Generated config.h only. Many projects commit a hand-written
# config.h, so this is anchored and off by default; uncomment if
# yours is generated by configure.
# /config.h
# Remove the next two lines if you commit generated Makefiles/configure
Makefile.in
/configure

# ---------- Coverage & profiling ----------
*.gcno
*.gcda
*.gcov
gmon.out
coverage/
*.profraw
*.profdata

# ---------- Static analysis / tooling caches ----------
.cache/
.clangd/
.ccls-cache/

# =============================================================
# Additions: secrets, local config, logs
# =============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
# Per-machine build settings (make/local.mk in the build templates)
local.mk
# If a project must commit public certs or test keys, re-include them
# explicitly, e.g.:
# !tests/fixtures/*.pem

*.log
*.tmp
*.bak
*.swp

# OS/editor files (.DS_Store, .idea/, .vscode/, etc.) belong in each
# developer's global gitignore, not here.